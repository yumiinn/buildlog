# Required: copy the Session pooler connection information from Supabase Connect.
# Use session mode (port 5432). Keep this value only in backend/.env.
# If the database password contains reserved URL characters, use the encoded value.
DATABASE_URL=

# Optional for local use: set a long random value to keep login tokens valid after a restart.
APP_SECRET_KEY=

# Optional: comma-separated frontend origins allowed to call FastAPI.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
